# Server
PORT=3000
DATA_DIR=/data
PUBLIC_URL=https://shiori.yourdomain.com
SERVER_NAME=shiori
IDEAS_DIR=ideas
TIMEZONE=America/Sao_Paulo
# Number of lines returned by memory_wake (default 96 ≈ 6–8k tokens; reading budget only)
MEMORY_WAKE_LINES=96

# GitHub OAuth App (Authorization callback URL: ${PUBLIC_URL}/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user ID (find yours at https://api.github.com/users/<username>)
OWNER_GITHUB_ID=

# Extra OAuth redirect URI prefixes (comma-separated) for clients like Muse or Grok.
# Claude, ChatGPT, and localhost are allowed by default.
ALLOWED_REDIRECT_PREFIXES=
# Set to "true" temporarily if you want to allow any https:// redirect URI while discovering client callbacks.
ALLOW_ALL_HTTPS_REDIRECTS=false

# Admin bearer token for /admin/grants and /admin/reconcile (generate with: openssl rand -hex 32)
ADMIN_SECRET=

# Semantic search embeddings: "openai", "gemini", or "none" (keyword FTS5 only)
EMBEDDING_PROVIDER=openai
# Provide EMBEDDING_API_KEY (or OPENAI_API_KEY / GEMINI_API_KEY)
EMBEDDING_API_KEY=
# Defaults: text-embedding-3-small (openai) or gemini-embedding-001 (gemini)
EMBEDDING_MODEL=
# Optional custom OpenAI-compatible base URL
EMBEDDING_BASE_URL=

# Optional Git remote URL to back up commits.
# Prefer a scoped fine-grained token or SSH deploy key rather than a broad PAT.
GIT_REMOTE_URL=
GIT_AUTHOR_NAME=Shiori
GIT_AUTHOR_EMAIL=shiori@localhost
