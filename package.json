{
  "name": "shiori",
  "description": "Shared memory and Markdown notes for all your AI agents. Self-hosted MCP server with binary-tree episodic memory, hybrid search, Git history, and OAuth 2.1.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "node scripts/lint-no-emdash.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
